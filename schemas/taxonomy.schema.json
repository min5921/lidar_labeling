{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/lidar-label-tool/taxonomy.schema.json",
  "title": "Dataset label taxonomy v2",
  "type": "object",
  "required": ["schema_version", "display_name", "classes"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/classDefinition" }
    },
    "fallback_class_id": { "$ref": "#/$defs/machineId" },
    "source_mappings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "$ref": "#/$defs/machineId" }
      }
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false,
  "$comment": "Class IDs, aliases, and shortcuts must be unique; fallback and mapping targets must exist. These are runtime cross-item validations.",
  "$defs": {
    "machineId": {
      "type": "string",
      "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$))[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9_-])?$"
    },
    "classDefinition": {
      "type": "object",
      "required": ["id", "display_name", "color", "default_size_m"],
      "properties": {
        "id": { "$ref": "#/$defs/machineId" },
        "display_name": { "type": "string", "minLength": 1 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "default_size_m": {
          "type": "object",
          "required": ["length", "width", "height"],
          "properties": {
            "length": { "type": "number", "exclusiveMinimum": 0 },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        },
        "shortcut": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
