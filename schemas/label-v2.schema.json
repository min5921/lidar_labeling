{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/lidar-label-tool/label-v2.schema.json",
  "title": "LiDAR Label Tool profile-scoped frame label v2",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_id",
    "profile_id",
    "label_lidar_id",
    "frame_id",
    "label_lidar_sample_id",
    "revision",
    "frame_status",
    "saved_at_utc",
    "point_cloud_path",
    "image_path",
    "reference_frame",
    "coordinate_system",
    "provenance",
    "calibration_state",
    "objects"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "dataset_id": { "$ref": "#/$defs/machineId" },
    "profile_id": { "$ref": "#/$defs/machineId" },
    "label_lidar_id": { "$ref": "#/$defs/machineId" },
    "frame_id": { "$ref": "#/$defs/machineId" },
    "label_lidar_sample_id": { "$ref": "#/$defs/machineId" },
    "revision": { "type": "integer", "minimum": 1 },
    "frame_status": {
      "enum": ["unvisited", "in_progress", "reviewed", "skipped"]
    },
    "saved_at_utc": { "type": "string", "format": "date-time" },
    "point_cloud_path": { "$ref": "#/$defs/dataRelativePath" },
    "image_path": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/dataRelativePath" }
      ]
    },
    "reference_frame": { "type": "string", "minLength": 1 },
    "coordinate_system": { "$ref": "#/$defs/coordinateSystem" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "calibration_state": { "$ref": "#/$defs/calibrationState" },
    "objects": {
      "type": "array",
      "items": { "$ref": "#/$defs/labeledObject" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "image_path": { "type": "null" } },
        "required": ["image_path"]
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": { "image_sha256": { "type": "null" } }
          }
        }
      },
      "else": {
        "properties": {
          "provenance": {
            "properties": {
              "image_sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true,
  "$comment": "The semantic validator must compare dataset/profile/LiDAR/frame/reference identity, profile and frame bindings, fingerprints, and paths before both load and save.",
  "$defs": {
    "machineId": {
      "type": "string",
      "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$))[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9_-])?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "configRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "dataRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "coordinateSystem": {
      "type": "object",
      "required": [
        "unit",
        "x_axis",
        "y_axis",
        "z_axis",
        "yaw_axis",
        "yaw_unit",
        "yaw_zero",
        "yaw_direction",
        "box_center"
      ],
      "properties": {
        "unit": { "const": "meter" },
        "x_axis": { "const": "forward" },
        "y_axis": { "const": "left" },
        "z_axis": { "const": "up" },
        "yaw_axis": { "const": "+z" },
        "yaw_unit": { "const": "radian" },
        "yaw_zero": { "const": "+x" },
        "yaw_direction": { "const": "counterclockwise" },
        "box_center": { "const": "geometric_center" }
      },
      "additionalProperties": false
    },
    "pathFingerprint": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/configRelativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "frameIndexFingerprint": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "lidar_binding_sha256",
        "frame_record_sha256"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/configRelativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "lidar_binding_sha256": { "$ref": "#/$defs/sha256" },
        "frame_record_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_format",
        "source_paths",
        "source_fingerprints",
        "dataset_manifest",
        "profile_sha256",
        "frame_index",
        "taxonomy",
        "point_cloud_sha256",
        "image_sha256"
      ],
      "properties": {
        "source_format": { "type": "string", "minLength": 1 },
        "source_paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/dataRelativePath" },
          "uniqueItems": true
        },
        "source_fingerprints": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/dataRelativePath" },
          "additionalProperties": { "$ref": "#/$defs/sha256" }
        },
        "dataset_manifest": { "$ref": "#/$defs/pathFingerprint" },
        "profile_sha256": { "$ref": "#/$defs/sha256" },
        "frame_index": { "$ref": "#/$defs/frameIndexFingerprint" },
        "taxonomy": { "$ref": "#/$defs/pathFingerprint" },
        "point_cloud_sha256": { "$ref": "#/$defs/sha256" },
        "image_sha256": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        },
        "migration": { "$ref": "#/$defs/migration" }
      },
      "additionalProperties": true
    },
    "calibrationState": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "requested_mode",
            "effective_mode",
            "path",
            "fingerprint",
            "status"
          ],
          "properties": {
            "requested_mode": { "const": "none" },
            "effective_mode": { "const": "none" },
            "path": { "type": "null" },
            "fingerprint": { "type": "null" },
            "status": { "const": "not_configured" }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "requested_mode",
            "effective_mode",
            "path",
            "fingerprint",
            "status"
          ],
          "properties": {
            "requested_mode": { "const": "display_only" },
            "effective_mode": { "const": "display_only" },
            "path": { "type": "null" },
            "fingerprint": { "type": "null" },
            "status": { "enum": ["not_configured", "disabled"] }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "requested_mode",
            "effective_mode",
            "path",
            "fingerprint",
            "status"
          ],
          "properties": {
            "requested_mode": { "const": "calibrated" },
            "effective_mode": { "const": "calibrated" },
            "path": { "$ref": "#/$defs/configRelativePath" },
            "fingerprint": { "$ref": "#/$defs/sha256" },
            "status": { "const": "valid" }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "requested_mode",
            "effective_mode",
            "path",
            "fingerprint",
            "status"
          ],
          "properties": {
            "requested_mode": { "const": "calibrated" },
            "effective_mode": { "const": "display_only" },
            "path": { "$ref": "#/$defs/configRelativePath" },
            "fingerprint": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/sha256" }
              ]
            },
            "status": { "enum": ["missing", "invalid", "disabled"] }
          },
          "additionalProperties": true
        }
      ]
    },
    "migration": {
      "type": "object",
      "required": [
        "from_schema_version",
        "source_path",
        "source_sha256",
        "source_revision",
        "migrated_at_utc",
        "tool_version",
        "class_mapping_sha256"
      ],
      "properties": {
        "from_schema_version": { "const": "1.0" },
        "source_path": { "$ref": "#/$defs/configRelativePath" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "source_revision": { "type": "integer", "minimum": 0 },
        "migrated_at_utc": { "type": "string", "format": "date-time" },
        "tool_version": { "type": "string", "minLength": 1 },
        "legacy_dataset_id": { "type": "string", "minLength": 1 },
        "class_mapping_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "labeledObject": {
      "type": "object",
      "required": ["id", "class_id", "box3d"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "class_id": { "$ref": "#/$defs/machineId" },
        "box3d": { "$ref": "#/$defs/box3d" },
        "attributes": { "type": "object" },
        "source": { "type": "object" }
      },
      "additionalProperties": true
    },
    "box3d": {
      "type": "object",
      "required": ["x", "y", "z", "length", "width", "height", "yaw"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "length": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "yaw": {
          "type": "number",
          "minimum": -3.141592653589793,
          "exclusiveMaximum": 3.141592653589793
        }
      },
      "additionalProperties": false
    }
  }
}
